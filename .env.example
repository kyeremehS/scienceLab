# Copy to .env and fill secrets. Never commit .env.
DATABASE_URL="postgresql://sciencelab:sciencelab_dev@localhost:5432/sciencelab"

# Dev-only. Production MUST override with 32+ random chars (CR-12).
SESSION_SECRET="dev-only-secret-change-in-production-000000"

# Live AI answers. Omit to run the offline fallback.
OPENROUTER_API_KEY=""
# AI_MODEL="thinkingmachines/inkling-small"

# Mail: localhost:1025 is Mailpit (docker compose). Production (Brevo):
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="brevo-login-email"
# SMTP_PASSWORD="brevo-smtp-key"
# EMAIL_FROM="ScienceLab <noreply@yourdomain.com>"
# Or log links server-side instead: EMAIL_PROVIDER="console"
